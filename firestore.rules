rules_version = '2';

// =============================================================================
// Aqarat — multi-tenant security rules.
//
// Tenant boundary: a document is only readable/writable by users whose
// `users/{uid}.company_id` matches the document's `company_id`.
//
// Super Admins (SaaS owners) are identified by their profile document
// (users/{uid}.role == 'super_admin') — NOT by a hardcoded email. This supports
// any number of super admins, managed as Firestore documents. They may
// provision companies and users across all tenants.
// =============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function profileExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn() && profileExists()
        && userData().role == 'super_admin';
    }

    // True if the signed-in user has a profile and belongs to company [cid].
    // Membership ONLY — see activeMember() for the check that also enforces the
    // trial deadline.
    function sameCompany(cid) {
      return isSignedIn() && profileExists() && userData().company_id == cid;
    }

    // A demo (trial) company stops serving data once `demo_expires_at` passes.
    // Enforced here and not merely in the app, since a client that skips its
    // own expiry screen would otherwise keep full access.
    //
    // Safe field access: a company provisioned before the demo flag existed has
    // neither field, and reading a missing field ERRORS → denies everything.
    // A company marked demo with NO deadline stored is treated as expired
    // (default `request.time`, which is never < itself) — failing closed.
    function companyActive(cid) {
      return !get(/databases/$(database)/documents/companies/$(cid))
          .data.get('demo', false)
        || request.time < get(/databases/$(database)/documents/companies/$(cid))
          .data.get('demo_expires_at', request.time);
    }

    // Membership AND a live subscription. This is the gate for every data
    // collection. `users` and `companies` reads deliberately stay on plain
    // sameCompany(), so an expired tenant can still resolve its session and be
    // TOLD it expired instead of hitting an opaque permission error.
    function activeMember(cid) {
      return sameCompany(cid) && companyActive(cid);
    }

    // A company admin (branch-scoped or not). Deleting a signed contract or a
    // receipt is not an everyday agent action — both screens already hide the
    // button from agents, and this makes that stick for a caller that skips the
    // app. Editing stays open to agents: correcting a typo is routine work.
    function isCompanyAdmin() {
      return isSignedIn() && profileExists()
        && userData().role == 'company_admin';
    }

    // True if the user sees EVERY branch of their company: a company-wide admin
    // (a company_admin who is NOT branch-scoped). Super admins are handled
    // separately at each rule. Only called once sameCompany() proved the profile
    // exists, so userData() is safe here.
    // Safe field access (.get with default): a user doc created before the
    // branch system may LACK `branch` / `branch_admin`, and reading a missing
    // field in rules ERRORS → denies the whole request. Defaults keep such
    // accounts working (treated as company-wide-eligible / empty branch).
    function seesAllBranches() {
      return userData().role == 'company_admin'
        && userData().get('branch_admin', false) != true;
    }

    // Branch boundary: a member may touch a doc in company [cid] / branch
    // [branch] only if they belong to that company AND either see all branches
    // or sit in the same branch. Agents and branch-scoped admins are thus
    // confined to their own branch's data.
    function inBranch(cid, branch) {
      return activeMember(cid)
        && (seesAllBranches() || userData().get('branch', '') == branch);
    }

    // --- Global app config (e.g. the Super-Admin-edited plan matrix). Any
    //     signed-in user may read it (the app gates features off it); only
    //     Super Admins may edit. Plan feature gating is enforced in the app +
    //     the admin provisioning flow, not here.
    match /config/{doc} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // --- User profiles.
    //     ONLY the Super Admin provisions profiles (the app has no self-signup).
    //     A self-created profile is forbidden: otherwise anyone who registers an
    //     auth account could mint themselves a company_admin profile on any
    //     company and breach that tenant. A user may update only their own
    //     editable fields and never their company_id / role.
    match /users/{uid} {
      allow read: if isSuperAdmin() || (isSignedIn() &&
        (request.auth.uid == uid || sameCompany(resource.data.company_id)));
      allow create: if isSuperAdmin();
      // `branch` and `branch_admin` are pinned alongside company_id and role:
      // inBranch() and seesAllBranches() read them straight off this document,
      // so a member able to edit them could move themselves into another
      // branch — or, as a branch-scoped company_admin, clear branch_admin and
      // gain the whole company. The app never writes either field (a profile
      // edit only ever touches photo_url); only the Super Admin provisioning
      // path sets them, and that goes through the isSuperAdmin() branch above.
      // Safe field access: profiles created before branches existed carry
      // neither field, and reading a missing field ERRORS — .get() with a
      // default keeps those accounts editable.
      allow update: if isSuperAdmin() || (isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.company_id == resource.data.company_id
        && request.resource.data.role == resource.data.role
        && request.resource.data.get('branch', '')
             == resource.data.get('branch', '')
        && request.resource.data.get('branch_admin', false)
             == resource.data.get('branch_admin', false));
      allow delete: if isSuperAdmin();
    }

    // --- Companies. Members READ their own company; only the Super Admin may
    //     create/edit/delete it (plan, city, web_only, feature_overrides,
    //     branches are all sold/provisioned — a member must not self-upgrade).
    match /companies/{companyId} {
      allow read: if isSuperAdmin() || sameCompany(companyId);
      allow create, update, delete: if isSuperAdmin();
    }

    // --- Aggregated stats: one doc per company (doc id == company_id).
    match /company_stats/{companyId} {
      allow read, write: if isSuperAdmin() || activeMember(companyId);
    }

    // --- Contracts: company- AND branch-scoped. A member only ever touches
    //     their own branch's docs (company-wide admins + super admins see all).
    //     company_id and branch are pinned on update so a doc can never be
    //     re-tagged into another tenant or branch.
    match /contracts/{id} {
      allow read:   if isSuperAdmin()
        || inBranch(resource.data.company_id, resource.data.branch);
      allow create: if inBranch(request.resource.data.company_id,
        request.resource.data.branch);
      allow update: if (isSuperAdmin()
          || inBranch(resource.data.company_id, resource.data.branch))
        && request.resource.data.company_id == resource.data.company_id
        && request.resource.data.branch == resource.data.branch;
      allow delete: if isSuperAdmin()
        || (isCompanyAdmin()
            && inBranch(resource.data.company_id, resource.data.branch));
    }

    // --- Receipts (وەصڵ): company- AND branch-scoped, same as contracts.
    match /receipts/{id} {
      allow read:   if isSuperAdmin()
        || inBranch(resource.data.company_id, resource.data.branch);
      allow create: if inBranch(request.resource.data.company_id,
        request.resource.data.branch);
      allow update: if (isSuperAdmin()
          || inBranch(resource.data.company_id, resource.data.branch))
        && request.resource.data.company_id == resource.data.company_id
        && request.resource.data.branch == resource.data.branch;
      allow delete: if isSuperAdmin()
        || (isCompanyAdmin()
            && inBranch(resource.data.company_id, resource.data.branch));
    }

    // --- Notifications: raised ONLY by the scanDueDates schedule, which runs on
    //     the Admin SDK and bypasses these rules entirely. Hence no create path
    //     for members — a client that could mint notifications could fake an
    //     alert about another branch's contract.
    //
    //     Visibility copies the contract's own company + branch, so a member
    //     sees alerts for exactly the contracts they can already open.
    //
    //     The only member write is marking one read. hasOnly(['read_by']) is
    //     what keeps that honest: without it, "update" would let anyone rewrite
    //     the title/body of an alert everyone else is looking at.
    match /notifications/{id} {
      allow read:   if isSuperAdmin()
        || inBranch(resource.data.company_id, resource.data.branch);
      allow create: if isSuperAdmin();
      allow update: if (isSuperAdmin()
          || inBranch(resource.data.company_id, resource.data.branch))
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['read_by']);
      allow delete: if isSuperAdmin()
        || (isCompanyAdmin()
            && inBranch(resource.data.company_id, resource.data.branch));
    }

    // --- Contract templates (تێمپلەیت): one doc per company (id == company_id).
    //     The owning company reads it to render PDFs; only super admins edit.
    match /templates/{companyId} {
      allow read:  if isSuperAdmin() || activeMember(companyId);
      allow write: if isSuperAdmin();
    }

    // --- Lawyers (پارێزەران): a company-scoped directory. EVERY member reads
    //     it — agents pick a lawyer on the sale contract form — but only a
    //     company admin curates it. Not branch-scoped: the directory is a
    //     company-wide address book, not per-branch data.
    match /lawyers/{id} {
      allow read:   if isSuperAdmin() || activeMember(resource.data.company_id);
      allow create: if isSuperAdmin()
        || (isCompanyAdmin()
            && activeMember(request.resource.data.company_id));
      allow update: if (isSuperAdmin()
          || (isCompanyAdmin() && activeMember(resource.data.company_id)))
        && request.resource.data.company_id == resource.data.company_id;
      allow delete: if isSuperAdmin()
        || (isCompanyAdmin() && activeMember(resource.data.company_id));
    }

    // --- Listings: STRICTLY company-scoped. These docs hold private owner
    //     name/phone, so they are NEVER readable cross-company. The Global
    //     Market reads the separate owner-free `market` collection instead.
    match /properties/{id} {
      allow read:   if isSuperAdmin()
        || inBranch(resource.data.company_id, resource.data.branch);
      allow create: if inBranch(request.resource.data.company_id,
        request.resource.data.branch);
      allow update: if (isSuperAdmin()
          || inBranch(resource.data.company_id, resource.data.branch))
        && request.resource.data.company_id == resource.data.company_id
        && request.resource.data.branch == resource.data.branch;
      allow delete: if isSuperAdmin()
        || inBranch(resource.data.company_id, resource.data.branch);
    }

    match /requests/{id} {
      allow read:   if isSuperAdmin()
        || inBranch(resource.data.company_id, resource.data.branch);
      allow create: if inBranch(request.resource.data.company_id,
        request.resource.data.branch);
      allow update: if (isSuperAdmin()
          || inBranch(resource.data.company_id, resource.data.branch))
        && request.resource.data.company_id == resource.data.company_id
        && request.resource.data.branch == resource.data.branch;
      allow delete: if isSuperAdmin()
        || inBranch(resource.data.company_id, resource.data.branch);
    }

    // --- Market: the public, owner-free projection of public listings. Any
    //     signed-in user may READ it (cross-company browsing) — it carries no
    //     owner name/phone. A company writes only its own market docs, and the
    //     owner-free guarantee is enforced here (not just client-side): a market
    //     doc may never carry the private owner_name / owner_mobile fields.
    function marketOwnerFree() {
      return !('owner_name' in request.resource.data)
        && !('owner_mobile' in request.resource.data);
    }
    match /market/{id} {
      // Reading is cross-company by design, so it cannot be gated on the
      // document's own company. It is gated on the READER's company instead —
      // an expired tenant loses the market along with everything else.
      // profileExists() first: userData() on a signed-in account with no
      // profile ERRORS, which would deny even the super-admin branch.
      allow read:   if isSignedIn() && profileExists()
        && (isSuperAdmin() || activeMember(userData().company_id));
      allow create: if activeMember(request.resource.data.company_id)
        && marketOwnerFree();
      allow update: if activeMember(resource.data.company_id)
        && request.resource.data.company_id == resource.data.company_id
        && marketOwnerFree();
      allow delete: if activeMember(resource.data.company_id);
    }
  }
}
