rules_version = '2';

// Reads are open to signed-in users (logos are public branding); WRITES are
// restricted to the owning company (logos to the Super Admin) so a company can
// never overwrite another's images. Everything else is denied.
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }
    // Cross-service Rules: reading Firestore from Storage Rules needs the
    // Firebase Rules service agent to hold roles/firebaserules.firestoreServiceAgent.
    // Without that grant every firestore.get() below fails and EVERY write is
    // denied — the CLI offers to add the role the first time it uploads a
    // ruleset that uses these functions.
    function callerData() {
      return firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function isImageUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Company logos — public branding, written by the Super Admin only.
    match /company_logos/{fileName} {
      allow read: if true;
      allow write: if isSignedIn()
        && callerData().role == 'super_admin'
        && isImageUnder5MB();
    }
    // Profile photos — public branding, like the logo. Public read so the web
    // build can fetch them with a plain URL (authenticated reads fail there).
    // Each user still writes ONLY their own (the file name is their uid).
    match /user_photos/{uid} {
      allow read: if true;
      allow write: if isSignedIn()
        && request.auth.uid == uid
        && isImageUnder5MB();
    }
    // Lawyer photos — only the owning company may write.
    match /lawyer_photos/{companyId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && callerData().company_id == companyId
        && isImageUnder5MB();
    }
    // House photos (listings) — public branding, like the company logo. They
    // are property photos, not sensitive documents, and the market shows them
    // cross-company anyway. Public read means the browser can fetch them with a
    // plain tokenised URL (no auth request), which is the only thing that
    // renders reliably on the web build. Writes stay owner-only.
    match /property_images/{companyId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn()
        && callerData().company_id == companyId
        && isImageUnder5MB();
    }
    // Contract document photos (IDs, deeds…) — sensitive, so reads AND writes
    // are restricted to the owning company (plus the Super Admin).
    match /contract_docs/{companyId}/{fileName} {
      allow read: if isSignedIn()
        && (callerData().role == 'super_admin'
            || callerData().company_id == companyId);
      allow write: if isSignedIn()
        && callerData().company_id == companyId
        && isImageUnder5MB();
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
