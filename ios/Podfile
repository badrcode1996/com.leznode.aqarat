# Aqarat / Grebast — iOS CocoaPods setup.
#
# This file exists ONLY to pin the deployment target. Without it CocoaPods
# assigns iOS 13.0 by default, and the build fails at `pod install` with
# "Specs satisfying the Flutter dependency were found, but they required a
# higher minimum deployment target" — which is what happened on Codemagic the
# first time the map shipped.
#
# 15.0 is the floor set by what the app actually uses:
#   • Flutter's own engine pod on current stable — above 13.0
#   • google_maps_flutter_ios — 14.0, and its GoogleMaps/Utils pair wants 15.0
#     for the 9.x line
#   • the Firebase pods in use — 13.0
# iOS 15 runs on the iPhone 6s and newer, so nothing in service is dropped.
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously, slowing every build.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path =
    File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running " \
          'pod install manually, make sure flutter pub get is executed first'
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. " \
        'Try deleting Generated.xcconfig, then run flutter pub get'
end

require File.expand_path(
  File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root
)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # Pods that declare an older floor otherwise keep it and Xcode warns on
      # every one of them; pinning here keeps the whole workspace on one target.
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
