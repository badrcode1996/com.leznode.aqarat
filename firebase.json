{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions"
    }
  ],
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/flutter_service_worker.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/flutter_bootstrap.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "//": "main.dart.js carries no content hash in its name, so Firebase's default max-age=3600 served the PREVIOUS build's code for up to an hour after every deploy — a fix looked like it had not shipped. version.json is what the service worker compares to decide there is a new build, so it must not be cached either.",
        "source": "/main.dart.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/version.json",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "//": "The icon font is tree-shaken to just the glyphs the build uses, and ships at a fixed path with no content hash. Cached, it pairs an old subset with new code and every newly-added icon renders blank. Flutter's service worker does the real caching, so revalidating here costs nothing.",
        "source": "/assets/**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
        ]
      }
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "aqarat-49fc2",
          "appId": "1:621558994857:android:81fd734f356269bc7d96b8",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "aqarat-49fc2",
          "configurations": {
            "android": "1:621558994857:android:81fd734f356269bc7d96b8",
            "ios": "1:621558994857:ios:0d0ba0aaa7280fa97d96b8"
          }
        }
      }
    }
  }
}
